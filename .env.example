# Copy to .env and fill in. Without the two API keys the app still runs in offline mode
# (keyword tag extraction, local hashing embeddings, source-only answers).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Change for any shared deployment.
JWT_SECRET=change-me
# Comma-separated emails that become admins at sign-up (the first account is always admin).
ADMIN_EMAILS=

# Agent team. Model per job; the critical model (checker, analyst) falls back automatically if the account cannot use it.
MODEL_BULK=claude-haiku-5-5
MODEL_CRITICAL=claude-fable-5-1
MODEL_CRITICAL_FALLBACK=claude-opus-5-5
# Spending cap on the Anthropic API key: agents stop when this month's spend reaches allowance x share.
API_MONTHLY_ALLOWANCE_USD=20
BUDGET_SHARE=0.5
AGENTS_ENABLED=true
